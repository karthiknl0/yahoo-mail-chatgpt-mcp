# Yahoo credentials. Use a Yahoo app-specific password, never your primary password.
YAHOO_EMAIL=you@example.com
YAHOO_APP_PASSWORD=replace-with-app-specific-password

# Required bearer token protecting /mcp. Generate a long random value.
MCP_API_TOKEN=replace-with-at-least-32-random-characters

# Network settings
PORT=3000
HOST=127.0.0.1

# For public deployment behind HTTPS, set the exact public hostname.
# Example: mcp.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional browser origins, comma-separated. MCP clients generally do not send Origin.
ALLOWED_ORIGINS=

# Mail output limits
MAX_EMAILS_PER_REQUEST=25
MAX_PREVIEW_CHARS=600
MAX_READ_CHARS=5000
IMAP_CONNECT_TIMEOUT_MS=15000
IMAP_COMMAND_TIMEOUT_MS=20000
