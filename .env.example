# Yahoo credentials. Use a Yahoo app-specific password, never your primary password.
YAHOO_EMAIL=you@example.com
YAHOO_APP_PASSWORD=replace-with-app-specific-password

# OAuth state store. For local development, run a Redis-compatible server.
REDIS_URL=redis://127.0.0.1:6379

# Use one canonical HTTPS origin. Render provides RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=https://localhost.example.test
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Generate the digest with `npm run hash-passphrase`; never enter plaintext here.
MCP_LOGIN_PASSPHRASE_SCRYPT=replace-with-generated-scrypt-digest
# Generate at least 32 random characters; keep this value private.
OAUTH_COOKIE_KEY=replace-with-at-least-32-random-characters

# Network settings
PORT=3000
HOST=127.0.0.1

# For public deployment behind HTTPS, set the exact public hostname.
# Example: mcp.example.com
ALLOWED_HOSTS=localhost.example.test,localhost,127.0.0.1

# Optional browser origins, comma-separated. MCP clients generally do not send Origin.
ALLOWED_ORIGINS=

# Mail output limits
MAX_EMAILS_PER_REQUEST=25
MAX_PREVIEW_CHARS=600
MAX_READ_CHARS=5000
IMAP_CONNECT_TIMEOUT_MS=15000
IMAP_COMMAND_TIMEOUT_MS=20000
